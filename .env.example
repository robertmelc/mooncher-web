# Zatím jen dokumentace proměnných z B7 — projekt v této fázi nemá žádné
# skutečné napojení na Supabase/Stripe/OneSignal.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Dočasné řešení pro platform_admin roli (viz konverzace k obrazovce adm-1) —
# čárkou oddělený seznam e-mailů, server-only, kontrolováno v lib/admin-auth.ts.
PLATFORM_ADMIN_EMAILS=

# GoSMS (SMS pozvánky do referral programu) — OAuth2 client_credentials,
# viz lib/sms.ts. GOSMS_CHANNEL je ID kanálu, ne tajemství.
GOSMS_CLIENT_ID=
GOSMS_CLIENT_SECRET=
GOSMS_CHANNEL=
